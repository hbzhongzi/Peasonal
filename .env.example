# 本地开发配置模板：复制为 .env 后按需修改，.env 不入库
#
# 本机 MySQL 8.0 已作为 Windows 服务运行（D:\MySQL\MySQL Server 8.0），
# 无需 docker-compose，填好下面的连接串即可。

APP_ENV=development
HTTP_ADDR=:8080

# ---- 数据库 ----
# 建库：CREATE DATABASE blog CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
# parseTime / loc / charset 三个参数即使不写，程序也会自动补齐
DATABASE_URL=root:123456@tcp(127.0.0.1:3306)/blog
DB_MAX_OPEN=25
DB_MAX_IDLE=5
DB_MAX_LIFETIME=30m

# ---- 认证 ----
# 至少 32 字节的随机串：openssl rand -base64 32
JWT_SECRET=change-me-to-a-32-bytes-random-string

# ---- 媒体（本地磁盘）----
MEDIA_DIR=./data/uploads
MEDIA_URL_PREFIX=/uploads
MEDIA_MAX_UPLOAD_MB=5
MEDIA_QUOTA_MB=2048

# ---- 站点 ----
BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_RPS=10
